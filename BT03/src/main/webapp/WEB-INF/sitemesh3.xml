<?xml version="1.0" encoding="UTF-8"?>

<sitemesh>

    <mapping path="/admin/*"
             decorator="admin.jsp" />
                 <mapping path="/manager/*"
             decorator="manager.jsp" />
                 <mapping path="/user/*"
             decorator="user.jsp" />

    <!-- A single Bootstrap template is shared by public, admin, manager and user views. -->
    <mapping path="/*"
             name="web"
             decorator="web.jsp" />

    <!-- CHƯA DÙNG -->
    <mapping path="/v1/api/"
             name="api"
             exclude="true" />

</sitemesh>
